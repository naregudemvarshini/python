class Solution:
    def partition(self, s: str) -> List[List[str]]:
        res=[]
        path=[]
        def ispal(str,e):
            while str<e:
                if s[str]!=s[e]:
                    return False
                str+=1
                e-=1
            return True
        def bt(st):
            if st==len(s):
                res.append(path[:])
                return
            for end in range(st,len(s)):
                if ispal(st,end):
                    path.append(s[st:end+1])
                    bt(end+1)
                    path.pop()
        bt(0)
        return res
