def checkValidString(self, s: str) -> bool:
        minopen=maxopen=0
        for c in s:
            if c=='(':
                minopen+=1
                maxopen+=1
            elif c==')':
                minopen=max(minopen-1,0)
                maxopen-=1
            elif c=='*':
                minopen=max(minopen-1,0)
                maxopen+=1
            if maxopen<0:
                return False
        return minopen==0
